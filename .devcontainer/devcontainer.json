{
  "name": "Flutter Finance App",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {}
  },
  "onCreateCommand": "git clone https://github.com/flutter/flutter.git -b stable --depth 1 /workspaces/flutter 2>/dev/null || true",
  "postCreateCommand": "echo 'export PATH=$PATH:/workspaces/flutter/bin' >> ~/.bashrc && /workspaces/flutter/bin/flutter precache --web",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "App Web",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code"
      ]
    }
  }
}
